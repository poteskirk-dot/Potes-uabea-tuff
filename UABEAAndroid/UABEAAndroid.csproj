<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <TargetFramework>net8.0-android34.0</TargetFramework>

    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <ApplicationTitle>UABEA Android</ApplicationTitle>
    <ApplicationId>com.potes.uabeaandroid</ApplicationId>

    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidUseLatestPlatformSdk>true</AndroidUseLatestPlatformSdk>
    <PublishTrimmed>false</PublishTrimmed>

    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Android" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AssetsTools.NET">
      <HintPath>../Assets/AssetsTools.NET.dll</HintPath>
      <Private>true</Private>
    </Reference>

    <AndroidAsset Include="../Assets/classdata.tpk"
                  Link="classdata.tpk" />

    <AndroidResource Include="Resources/values/styles.xml" />
  </ItemGroup>

</Project>
